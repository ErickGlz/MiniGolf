<Window x:Class="MiniGolf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniGolf"
        mc:Ignorable="d"
        Title="MainWindow"    Height="820"
        Width="1300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#17202A">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#212F3D"
                BorderBrush="#34495E"
                BorderThickness="0,0,0,2">

            <Grid Margin="40,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="MINI GOLF IA"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="Bold"/>

                    <TextBlock Text="Jugador vs Inteligencia Artificial"
                               Foreground="#ABB2B9"
                               FontSize="14"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="JUGADOR"
                               Foreground="#58D68D"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="txtGolpesJugador"
                               Text="Golpes: 0"
                               Foreground="White"
                               FontSize="19"/>

                </StackPanel>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="IA - A*"
                               Foreground="#5DADE2"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="txtGolpesIA"
                               Text="Golpes: 0"
                               Foreground="White"
                               FontSize="19"/>

                </StackPanel>

                <StackPanel Grid.Column="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="NIVEL"
                               Foreground="#F4D03F"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>

                    <TextBlock Text="1"
                               Foreground="White"
                               FontSize="19"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <Border Grid.Row="1"
                Margin="30"
                Background="#145A32"
                CornerRadius="22"
                BorderBrush="#0B5345"
                BorderThickness="7">

            <Canvas x:Name="Campo"
                    Width="1200"
                    Height="650"
                    Background="#27AE60"
                    ClipToBounds="True"
                    MouseMove="Campo_MouseMove"
                    MouseLeftButtonUp="Campo_MouseLeftButtonUp">

                <Rectangle Width="1200"
                           Height="90"
                           Fill="#239B56"
                           Canvas.Top="280"
                           IsHitTestVisible="False"/>

                <Ellipse Width="300"
                         Height="200"
                         Fill="#2ECC71"
                         Canvas.Left="-70"
                         Canvas.Top="-40"
                         Opacity="0.65"
                         IsHitTestVisible="False"/>

                <Ellipse Width="360"
                         Height="230"
                         Fill="#2ECC71"
                         Canvas.Left="900"
                         Canvas.Top="430"
                         Opacity="0.65"
                         IsHitTestVisible="False"/>

                <TextBlock Text="SALIDA"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           Canvas.Left="55"
                           Canvas.Top="290"/>

                <Line X1="55"
                      Y1="315"
                      X2="155"
                      Y2="315"
                      Stroke="White"
                      StrokeThickness="2"
                      StrokeDashArray="5,3"/>

                <Ellipse Width="190"
                         Height="105"
                         Fill="#F4D03F"
                         Stroke="#D4AC0D"
                         StrokeThickness="5"
                         Canvas.Left="230"
                         Canvas.Top="65"
                         IsHitTestVisible="False"/>

                <Ellipse Width="155"
                         Height="75"
                         Fill="#F7DC6F"
                         Canvas.Left="248"
                         Canvas.Top="80"
                         IsHitTestVisible="False"/>

                <Ellipse Width="26"
                         Height="18"
                         Fill="#B7950B"
                         Canvas.Left="275"
                         Canvas.Top="100"
                         IsHitTestVisible="False"/>

                <Ellipse Width="30"
                         Height="20"
                         Fill="#B7950B"
                         Canvas.Left="330"
                         Canvas.Top="125"
                         IsHitTestVisible="False"/>

                <Border Width="170"
                        Height="100"
                        Background="#7D6608"
                        BorderBrush="#5B4A07"
                        BorderThickness="6"
                        CornerRadius="50"
                        Canvas.Left="190"
                        Canvas.Top="400">

                    <Grid>

                        <Ellipse Margin="10"
                                 Fill="#196F3D"/>

                        <Ellipse Width="95"
                                 Height="55"
                                 Fill="#1E8449"/>

                        <Ellipse Width="25"
                                 Height="20"
                                 Fill="#566573"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="30,25,0,0"/>

                        <Ellipse Width="32"
                                 Height="24"
                                 Fill="#5D6D7E"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,28,20"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared1"
                           Width="170"
                           Height="100"
                           Fill="Transparent"
                           Canvas.Left="190"
                           Canvas.Top="400"/>

                <Border Width="200"
                        Height="65"
                        Background="#935116"
                        BorderBrush="#6E2C00"
                        BorderThickness="5"
                        CornerRadius="25"
                        Canvas.Left="380"
                        Canvas.Top="205">

                    <Grid>

                        <Rectangle Margin="12"
                                   Fill="#A65F1A"
                                   RadiusX="12"
                                   RadiusY="12"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared2"
                           Width="200"
                           Height="65"
                           Fill="Transparent"
                           Canvas.Left="380"
                           Canvas.Top="205"/>

                <Border Width="170"
                        Height="100"
                        Background="#616A6B"
                        BorderBrush="#424949"
                        BorderThickness="6"
                        CornerRadius="45"
                        Canvas.Left="480"
                        Canvas.Top="440">

                    <Grid>

                        <Ellipse Width="50"
                                 Height="38"
                                 Fill="#7B7D7D"
                                 HorizontalAlignment="Left"
                                 Margin="20,0,0,0"/>

                        <Ellipse Width="43"
                                 Height="34"
                                 Fill="#85929E"/>

                        <Ellipse Width="52"
                                 Height="40"
                                 Fill="#515A5A"
                                 HorizontalAlignment="Right"
                                 Margin="0,0,20,0"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared3"
                           Width="170"
                           Height="100"
                           Fill="Transparent"
                           Canvas.Left="480"
                           Canvas.Top="440"/>

                <Border Width="180"
                        Height="95"
                        Background="#7D6608"
                        BorderBrush="#5B4A07"
                        BorderThickness="6"
                        CornerRadius="48"
                        Canvas.Left="625"
                        Canvas.Top="70">

                    <Grid>

                        <Ellipse Margin="10"
                                 Fill="#196F3D"/>

                        <Ellipse Width="100"
                                 Height="52"
                                 Fill="#1E8449"/>

                        <Ellipse Width="27"
                                 Height="21"
                                 Fill="#566573"
                                 HorizontalAlignment="Left"
                                 Margin="30,0,0,0"/>

                        <Ellipse Width="31"
                                 Height="23"
                                 Fill="#5D6D7E"
                                 HorizontalAlignment="Right"
                                 Margin="0,0,28,0"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared4"
                           Width="180"
                           Height="95"
                           Fill="Transparent"
                           Canvas.Left="625"
                           Canvas.Top="70"/>

                <Border Width="190"
                        Height="70"
                        Background="#935116"
                        BorderBrush="#6E2C00"
                        BorderThickness="5"
                        CornerRadius="25"
                        Canvas.Left="690"
                        Canvas.Top="300">

                    <Grid>

                        <Rectangle Margin="12"
                                   Fill="#A65F1A"
                                   RadiusX="12"
                                   RadiusY="12"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared5"
                           Width="190"
                           Height="70"
                           Fill="Transparent"
                           Canvas.Left="690"
                           Canvas.Top="300"/>

                <Border Width="180"
                        Height="100"
                        Background="#616A6B"
                        BorderBrush="#424949"
                        BorderThickness="6"
                        CornerRadius="45"
                        Canvas.Left="760"
                        Canvas.Top="470">

                    <Grid>

                        <Ellipse Width="55"
                                 Height="40"
                                 Fill="#7B7D7D"
                                 HorizontalAlignment="Left"
                                 Margin="20,0,0,0"/>

                        <Ellipse Width="45"
                                 Height="35"
                                 Fill="#85929E"/>

                        <Ellipse Width="55"
                                 Height="42"
                                 Fill="#515A5A"
                                 HorizontalAlignment="Right"
                                 Margin="0,0,20,0"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared6"
                           Width="180"
                           Height="100"
                           Fill="Transparent"
                           Canvas.Left="760"
                           Canvas.Top="470"/>

                <Border Width="170"
                        Height="95"
                        Background="#7D6608"
                        BorderBrush="#5B4A07"
                        BorderThickness="6"
                        CornerRadius="48"
                        Canvas.Left="900"
                        Canvas.Top="150">

                    <Grid>

                        <Ellipse Margin="10"
                                 Fill="#196F3D"/>

                        <Ellipse Width="95"
                                 Height="50"
                                 Fill="#1E8449"/>

                        <Ellipse Width="25"
                                 Height="20"
                                 Fill="#566573"
                                 HorizontalAlignment="Left"
                                 Margin="30,0,0,0"/>

                        <Ellipse Width="30"
                                 Height="22"
                                 Fill="#5D6D7E"
                                 HorizontalAlignment="Right"
                                 Margin="0,0,28,0"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared7"
                           Width="170"
                           Height="95"
                           Fill="Transparent"
                           Canvas.Left="900"
                           Canvas.Top="150"/>

                <Border Width="150"
                        Height="65"
                        Background="#616A6B"
                        BorderBrush="#424949"
                        BorderThickness="5"
                        CornerRadius="30"
                        Canvas.Left="955"
                        Canvas.Top="380">

                    <Grid>

                        <Ellipse Width="40"
                                 Height="28"
                                 Fill="#7B7D7D"
                                 HorizontalAlignment="Left"
                                 Margin="18,0,0,0"/>

                        <Ellipse Width="35"
                                 Height="26"
                                 Fill="#85929E"/>

                        <Ellipse Width="42"
                                 Height="30"
                                 Fill="#515A5A"
                                 HorizontalAlignment="Right"
                                 Margin="0,0,18,0"/>

                    </Grid>

                </Border>

                <Rectangle x:Name="Pared8"
                           Width="150"
                           Height="65"
                           Fill="Transparent"
                           Canvas.Left="955"
                           Canvas.Top="380"/>

                <Ellipse Width="185"
                         Height="125"
                         Fill="#229954"
                         Stroke="#1E8449"
                         StrokeThickness="4"
                         Canvas.Left="1000"
                         Canvas.Top="500"
                         IsHitTestVisible="False"/>

                <Ellipse Width="135"
                         Height="82"
                         Fill="#1E8449"
                         Opacity="0.55"
                         Canvas.Left="1025"
                         Canvas.Top="520"
                         IsHitTestVisible="False"/>

                <Ellipse x:Name="Hoyo"
                         Width="42"
                         Height="42"
                         Fill="#17202A"
                         Stroke="White"
                         StrokeThickness="3"
                         Canvas.Left="1090"
                         Canvas.Top="545"/>

                <Ellipse Width="50"
                         Height="15"
                         Fill="#145A32"
                         Canvas.Left="1086"
                         Canvas.Top="575"
                         Opacity="0.5"
                         IsHitTestVisible="False"/>

                <Line X1="1111"
                      Y1="555"
                      X2="1111"
                      Y2="460"
                      Stroke="White"
                      StrokeThickness="4"
                      IsHitTestVisible="False"/>

                <Polygon Points="1111,460 1170,480 1111,500"
                         Fill="#E74C3C"
                         IsHitTestVisible="False"/>

                <TextBlock Text="META"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"
                           Canvas.Left="1078"
                           Canvas.Top="600"/>

                <Line x:Name="LineaDireccion"
                      Stroke="White"
                      StrokeThickness="3"
                      StrokeDashArray="5,3"
                      Visibility="Hidden"
                      Panel.ZIndex="30"
                      IsHitTestVisible="False"/>

                <Ellipse x:Name="PelotaJugadorVisual"
                         Width="25"
                         Height="25"
                         Fill="White"
                         Stroke="#D5D8DC"
                         StrokeThickness="2"
                         Canvas.Left="70"
                         Canvas.Top="325"
                         MouseLeftButtonDown="PelotaJugador_MouseLeftButtonDown"
                         Panel.ZIndex="20"/>

                <Ellipse x:Name="PelotaIAVisual"
                         Width="25"
                         Height="25"
                         Fill="#3498DB"
                         Stroke="White"
                         StrokeThickness="2"
                         Canvas.Left="70"
                         Canvas.Top="370"
                         Panel.ZIndex="20"/>

            </Canvas>

        </Border>

    </Grid>

</Window>
